  "components": {
    "note": "Kích thước chuẩn cho mọi nút, popup, thông báo trên web và app. Nội dung luôn căn giữa theo chiều dọc; icon + chữ căn giữa, cách nhau 8px.",
    "button": {
      "sm": {
        "height": 32,
        "padding_x": 12,
        "font": 13,
        "icon": 16,
        "radius": 8
      },
      "md": {
        "height": 40,
        "padding_x": 16,
        "font": 14,
        "icon": 18,
        "radius": 10
      },
      "lg": {
        "height": 48,
        "padding_x": 20,
        "font": 16,
        "icon": 20,
        "radius": 12
      },
      "icon_only": {
        "sm": 32,
        "md": 40,
        "lg": 48
      },
      "touch_min": 44,
      "gap": 8,
      "rules": "Một nút chính (gradient) mỗi vùng; nút phụ viền mờ; nút nguy hiểm màu danger. Không xuống dòng giữa chữ; chữ dài thì nút rộng ra, không bị cắt. Trên điện thoại nút chính trong hộp thoại/sheet chiếm toàn chiều ngang."
    },
    "dialog": {
      "width": {
        "sm": 400,
        "md": 560,
        "lg": 720,
        "xl": 960
      },
      "radius": 16,
      "padding": 24,
      "header_height": 56,
      "footer_gap": 12,
      "max_height": "100dvh - 48px",
      "mobile": "<= 640px: thành bottom sheet toàn chiều ngang, bo góc trên 20px, có thanh kéo 36x4 ở giữa, nút ở footer dính đáy và chiếm toàn chiều ngang",
      "rules": "Luôn căn giữa màn hình (cả ngang và dọc) trên PC; tiêu đề trái + nút đóng (icon_only sm) phải; footer: nút phụ trái nút chính, căn phải; nội dung dài cuộn bên trong; nền mờ 60% + blur."
    },
    "confirm": {
      "width": 400,
      "icon": 40,
      "rules": "Icon tròn ở trên giữa, tiêu đề và mô tả căn giữa, hai nút bằng nhau chia đôi chiều ngang."
    },
    "toast": {
      "width": 360,
      "min_height": 48,
      "radius": 12,
      "icon": 20,
      "max_visible": 3,
      "duration_ms": 3500,
      "gap": 8,
      "position_desktop": "top-right, cách mép 16px, dưới header",
      "position_mobile": "top-center, rộng = màn hình - 24px, tránh tai thỏ (safe area)",
      "rules": "Icon trạng thái (success/info/warn/danger) bên trái căn giữa dọc, chữ 1–2 dòng, nút đóng bên phải; thanh màu 3px bên trái theo trạng thái; trượt vào 180ms."
    },
    "popover": {
      "notifications": {
        "width": 380,
        "max_height": 480,
        "item_min_height": 64,
        "radius": 14,
        "rules": "Neo dưới chuông, căn phải theo chuông; header 'Thông báo' + 'Đánh dấu đã đọc' ; item: chấm chưa đọc 8px bên trái căn giữa, tiêu đề đậm 1 dòng, mô tả 2 dòng, thời gian tương đối bên phải; trống: icon + 'Chưa có thông báo' căn giữa. Mobile: thành sheet toàn màn hình."
      },
      "menu": {
        "min_width": 200,
        "item_height": 40,
        "icon": 18,
        "radius": 12,
        "rules": "Item: icon trái + chữ, căn giữa dọc; nhóm cách nhau bằng đường kẻ; mục nguy hiểm màu danger ở cuối."
      }
    },
    "badge": {
