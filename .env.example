DATABASE_URL=postgresql+psycopg://thuetab:CHANGE_DATABASE_PASSWORD@db:5432/thuetab
POSTGRES_PASSWORD=CHANGE_DATABASE_PASSWORD
WORKER_TOKEN=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
WORKER_ID=local-1
WORKER_CAPACITY=20
PUBLIC_ORIGIN=http://127.0.0.1:8000
COOKIE_SECURE=false

# Cấu hình nạp tiền tự động qua SePay
SEPAY_API_KEY=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
BANK_NAME=
BANK_CODE=

# Bảng giá cạnh tranh (VNĐ)
PRICE_DAY=1500
PRICE_WEEK=8000
PRICE_MONTH=9000
PRICE_COMBO3M=24000
TRIAL_MINUTES=60

# Bật mạng có lọc cho Game Online (NSO, Avatar, Knight...)
ALLOW_FILTERED_EGRESS=true

# Liên hệ hỗ trợ hiển thị trên web/app (để trống sẽ ẩn)
SUPPORT_ZALO=
SUPPORT_TELEGRAM=
SUPPORT_EMAIL=

# JAR người dùng tải lên chạy ngay (true) hay chờ admin duyệt (false)
JAR_AUTO_APPROVE=true

# Token API SePay (my.sepay.vn → API Access) để tự quét giao dịch mỗi 30 giây, dự phòng khi webhook lỗi
SEPAY_API_TOKEN=

# Proxy được tin để lấy IP thật người dùng (Caddy/cloudflared cùng máy, gateway Docker)
TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12
